# =============================================================================
# expo-android-environment — local settings
# Copy to `.env` (scripts/setup.sh does this for you) and adjust.
# `.env` is git-ignored: never commit personal paths.
# =============================================================================

# --- Your Expo project -------------------------------------------------------
# Absolute path to the Expo project to mount into the container at /workspace.
# Can also be passed per-command: scripts/start.sh /path/to/my-app
PROJECT_DIR=

# Where screenshots / UI dumps are written, relative to PROJECT_DIR.
SCREENSHOT_DIR=.android-screenshots

# --- Isolated Android SDK on macOS -------------------------------------------
# Everything (emulator, system image, adb, AVD, logs) lives under this folder.
# Delete it and the host is back to its original state.
ENV_HOME=${HOME}/.expo-android-env

# --- Virtual device ----------------------------------------------------------
AVD_NAME=expo_pixel_api36
# Pixel 8-like screen. Change for other form factors.
AVD_DEVICE_NAME=pixel_8
AVD_LCD_WIDTH=1080
AVD_LCD_HEIGHT=2400
AVD_LCD_DENSITY=420
AVD_RAM_MB=4096
AVD_CORES=4
AVD_DATA_PARTITION=8G
# host = GPU acceleration via macOS; swiftshader_indirect = software fallback
EMULATOR_GPU=host
# true = no window (CI / agents only). false = show the phone window.
EMULATOR_HEADLESS=false

# --- Ports -------------------------------------------------------------------
# adb server on macOS (the container connects to it via host.docker.internal)
ADB_SERVER_PORT=5037
# Metro bundler (published to 127.0.0.1 only — not exposed to your LAN)
METRO_PORT=8081

# --- Docker resource limits --------------------------------------------------
CONTAINER_CPUS=4
CONTAINER_MEMORY=6g
# Force amd64: Google ships adb for Linux only on x86_64. On Apple Silicon
# the container runs under Rosetta/QEMU emulation automatically.
DOCKER_PLATFORM=linux/amd64

# Set to true if Fast Refresh does not pick up file changes on your machine.
WATCH_POLLING=false
