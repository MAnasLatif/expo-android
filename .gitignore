# --- Local configuration (copy .env.example -> .env) ---
.env
.env.*
!.env.example

# --- Never commit SDK binaries, AVDs or downloads ---
.sdk/
sdk/
avd/
downloads/
*.zip
*.apk
*.aab
*.tgz
node_modules/

# --- Generated artifacts ---
.android-screenshots/
*.log
logs/
tmp/

# --- OS / editor noise ---
.DS_Store
.vscode/
.idea/
*.swp

# --- UI server build output (server/build.sh; shipped in the npm package) ---
server/dist/
