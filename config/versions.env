# =============================================================================
# Pinned tool versions — the SINGLE source of truth for every download.
#
# Both the Docker image (build args) and the macOS host installer read this
# file. To upgrade a component, change it here, run `scripts/check-versions.sh`
# to see the latest available releases + checksums, and open a PR.
#
# IMPORTANT: PLATFORM_TOOLS_VERSION must be identical for macOS and Linux.
# The container's adb client talks to the host's adb server; if their versions
# differ, the client kills the server and everything disconnects.
# =============================================================================

# --- Container toolchain -----------------------------------------------------
UBUNTU_VERSION=24.04
JDK_VERSION=17
NODE_VERSION=24.22.3
BUN_VERSION=1.4.4

# Android command-line tools (Linux, container only — macOS does not need Java)
CMDLINE_TOOLS_BUILD=16111833
CMDLINE_TOOLS_LINUX_SHA1=e025545c62a8e64c7559119566a569fb1dec5f60

# --- Shared: Android platform-tools (adb) -----------------------------------
PLATFORM_TOOLS_VERSION=37.0.3
PLATFORM_TOOLS_LINUX_SHA1=e1579b288a7ae4e9bc28dedec6a154d78b3c04ed
PLATFORM_TOOLS_DARWIN_SHA1=eca4effbe35f4968139b051bbb16753302a3c33c

# --- macOS host: Android Emulator --------------------------------------------
EMULATOR_BUILD=16863232
EMULATOR_DARWIN_X64_SHA1=a5e8c52cd4b8f082f3f4e3bc4f5ba3e3765b8d84
EMULATOR_DARWIN_AARCH64_SHA1=05bbb7ae4e047e96204364e146e586037f4ad336

# --- macOS host: system image (Android 16 / API 36, Google APIs) ------------
SYSTEM_IMAGE_API=36
SYSTEM_IMAGE_TAG=google_apis
SYSTEM_IMAGE_REVISION=07
SYSTEM_IMAGE_X86_64_SHA1=c6bf44bdcd885bb902b4ba752d111a073ad7a817
SYSTEM_IMAGE_ARM64_SHA1=5a99183b6d924da606260e45fd41a3eb8eca6eb7
